# Calcular NDVI
NDVI <- chinu$normalizedDifference(c("B5", "B4"))$rename("NDVI")
# Mostrar NDVI
Map$addLayer(
eeObject = NDVI,
visParams = list(
min = -1,
max = 1,
palette = cpt("grass_ndvi", 10) #uso de library(cptcity)
),
name = "NDVI"
)
# Calcular el NBR usando la Banda 5 (NIR) y Banda 7 (SWIR 2)
NBR <- chinu$normalizedDifference(c("B5", "B7"))$rename("NBR")
# Mostrar NBR
Map$addLayer(
eeObject = NBR,
visParams = list(
min = -0.4,
max = 0.7,
palette = c("red", "yellow", "green") # Red indica zonas quemadas o suelo desnudo
),
name = "NBR"
)
dem <- ee$Image("NASA/NASADEM_HGT/001")$select("elevation")$clip(ar_ee)
# Mostrar dem
Map$addLayer(
eeObject = dem,
visParams = list(
min = 0,
max = 5000,
palette = c("#006400",
"#7FBF3F",
"#FEE08B",
"#D95F0E",
"#6D4C41")
),
name = "dem"
)
#Calcula el sombreado del relieve-DEM
terrain <- ee$Algorithms$Terrain(dem)
hillshade <- terrain$select("hillshade")
#Mostrar sombreado
Map$addLayer(
eeObject =hillshade,
visParams = list(
min = 0,
max = 255
),
name = "Hillshade"
)
# visualizar la pendiente
slope <- terrain$select("slope")
Map$addLayer(
eeObject = slope,
visParams = list(
min = 0,
max = 60,
palette = c( "#2E8B57",
"#8BC34A",
"#FDD835",
"#A1887F",
"#6D4C41")
),
name = "Pendiente"
)
